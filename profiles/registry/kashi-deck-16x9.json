{
  "schema": 1,
  "slug": "kashi-deck-16x9",
  "label": "Kashi deck (16:9)",
  "platform": "combined",
  "description": "The Kashi daily deck, rebuilt on the team's own page art (no text baked in): cover, summary table of sections, one page per post with platform logo, Handle Name, Social Media Report, date, Top N Posts, two-tone metric pills that appear only for the metrics the sheet has (Likes, Video views, Post Reach, Impressions, ReTweets), a LINK button and the screenshot filling its frame; then counter-comment sections as screenshot grids under a green band; a closing links page.",
  "capture": {
    "engine": "combined",
