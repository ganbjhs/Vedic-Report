# ---- Telegram -------------------------------------------------------------
# A SECOND bot from @BotFather: /newbot -> copy the token.
# Its own @username and its own DM window is the point — one bot, one job.
TG_SPLITTER_TOKEN=

# Who may use it. Comma-separated Telegram user ids; empty = anyone who finds
# it, which is fine on a laptop and not on the VPS. /whoami tells you your id.
TG_ALLOWED_IDS=

# ---- Permission -----------------------------------------------------------
# With a Report Maker token the registry decides who may send into a chat they
# are not standing in (the `send.other_chat` scope, Admin -> Bots).
APP_URL=https://report.vedictech.in
RM_TOKEN=

# Without one, this local allowlist is the gate instead. Same deliberate
# stopgap the report bot shipped with.
TG_SEND_OTHER_IDS=

# ---- Pacing ---------------------------------------------------------------
# Telegram allows roughly 20 messages a minute into one group. A 60-message
# batch takes ~3 minutes whatever these say; the bot paces rather than firing a
# burst, because a throttle that split a list in half would be worse than slow.
TG_GROUP_INTERVAL=3.1
TG_DM_INTERVAL=1.0

# How long the Undo button is offered after a delivery, in minutes. Telegram
# lets a bot delete its own messages for 48 hours; offering it that long would
# put an undo button next to yesterday's work.
TG_UNDO_MINUTES=30

# Refuse a batch bigger than this rather than sending for twenty minutes.
TG_MAX_MESSAGES=400

# ---- Features -------------------------------------------------------------
# Each is on unless said otherwise; `preview` ships OFF because Undo already
# answers "that was the wrong batch". Order of precedence:
#     built-in default  ->  these vars  ->  Admin -> Bots (needs RM_TOKEN)
# `/features` in the bot prints what is on and where each answer came from.
#
# TG_FEATURE_PREVIEW=on
# TG_FEATURE_TEXT_COMMANDS=off
# TG_FEATURE_UNDO=off
# TG_FEATURE_RECEIPT=off
# TG_FEATURE_FIXED_TEXT=off

# How often to re-read the dashboard's switches, in seconds. /sync is immediate.
TG_FEATURE_REFRESH=300
