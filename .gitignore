# Saved login session — contains live X auth cookies; NEVER commit this
sessions/

# Generated report output + screenshots (top-level and any depth under reports/)
reports/screenshots/
reports/**/screenshots/
reports/results.json
reports/**/results.json
reports/*.docx
reports/**/*.docx
reports/*.pdf

# scripts/capture_probe.py output — one PNG per probed link, evidence only
reports/probe/

# Web app secrets — app logins + session signing key; NEVER commit this.
# The bare `.env` pattern matches a file named exactly that and nothing else,
# so every sibling secrets file has to be named here too — `tg/.env.splitter`
# holds a bot token and would otherwise be committed by a plain `git add -A`.
.env
.env.*
!.env.example
!.env.*.example

# Web app runtime state — per-job working dirs, uploads, outputs, jobs.db
data/

# Deployment secret mount — holds x_state.json (a live X login) on the server
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Generated profile thumbnails (derived from profiles/registry)
webapp/static/profiles/

# Scratch folder for files this sandbox could not delete in place
_to_delete/
.env.bak.*
