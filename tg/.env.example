# ---- Telegram -------------------------------------------------------------
# From @BotFather: /newbot -> copy the token it gives you.
TG_BOT_TOKEN=

# Who may use the bot. Comma-separated Telegram user ids.
# Leave EMPTY while testing locally = anyone who finds the bot can use it.
# Send /whoami to the bot to learn your own id, then put it here.
TG_ALLOWED_IDS=

# ---- Report Maker ---------------------------------------------------------
# Where the app is. Local testing:
APP_URL=http://127.0.0.1:8000
# On the VPS:  APP_URL=https://report.vedictech.in

# An ordinary Report Maker account for the bot to sign in as.
# Add one to APP_USERS in the main .env, e.g.  APP_USERS=...,reportbot:somepassword
APP_USER=reportbot
APP_PASSWORD=

# How often to poll a running job, in seconds.
TG_POLL_SECONDS=4

# Seconds of quiet after the last link before the bot asks "Done?".
TG_SETTLE_SECONDS=3
